COMPOSE_PROJECT_NAME=hotelmanagement
TZ=Asia/Kolkata
FRONTEND_PORT=5200
BACKEND_PORT=5100
BACKEND_PORT_RANGE=5100-5102
DB_HOST=postgres
DB_PORT=5432
DB_EXTERNAL_PORT=3307
DB_ROOT_USER=root
DB_ROOT_PASSWORD=change_this_root_password
DB_USER=knockout
DB_PASSWORD=change_this_database_password
DB_NAME=knockout
MASTER_DB_NAME=knockout_master
MASTER_SESSION_SECRET=replace_with_at_least_32_random_characters
REDIS_URL=redis://redis:6379
REDIS_REQUIRED=true
REDIS_EVENTS_CHANNEL=knockout:state-events
DB_POOL_SIZE=20
DB_POOL_MAX_IDLE=10
DB_POOL_IDLE_TIMEOUT_MS=60000
DB_QUEUE_LIMIT=500
DB_CONNECT_TIMEOUT_MS=10000
TENANT_POOL_IDLE_MS=300000
MASTER_ADMIN_POOL_SIZE=20
MASTER_DB_POOL_SIZE=30
STATE_HISTORY_DAYS=90
STATE_CACHE_TTL_MS=1000
RUN_MIGRATIONS=true
PHPMYADMIN_PORT=9200
PHPMYADMIN_UPLOAD_LIMIT=64M
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ACCESS_KEY=knockout
MINIO_SECRET_KEY=change_this_minio_password
MINIO_BUCKET=food-images
MINIO_PUBLIC_URL=http://localhost:9100
STORAGE_PROVIDER=minio
STORAGE_BUCKET=food-images
STORAGE_PUBLIC_READ=true
# To use AWS S3 or another S3-compatible service, set STORAGE_PROVIDER=s3.
S3_ENDPOINT=s3.amazonaws.com
S3_PORT=443
S3_SSL=true
S3_REGION=ap-south-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_PATH_STYLE=false
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# PostgreSQL physical database; DB_NAME and MASTER_DB_NAME are schema names.
PGDATABASE=knockout
PG_EXTERNAL_PORT=5432
DB_TIMEZONE=Asia/Kolkata
PGSSL=false
SEED_DEMO_DATA=false
# Set a unique PIN only when bootstrapping a new installation; omitted for an import.
MASTER_BOOTSTRAP_PIN=

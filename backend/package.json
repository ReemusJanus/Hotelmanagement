{
  "name": "hotel-backend",
  "version": "1.0.0",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": "26.0.0",
    "npm": "11.12.1"
  },
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/check-runtime-versions.mjs",
    "dev": "node --env-file-if-exists=.env --watch src/main.js",
